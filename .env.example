# Webhook opzionale: riceve il JSON completo del lead (PII inclusa).
# Senza questa var i lead non vengono inoltrati (solo eventi ops nei log).
LEAD_WEBHOOK_URL=

# Rate limit su POST /api/lead (Upstash Redis REST).
# Senza queste var il rate limit è disattivato (ok in locale; obbligatorio in prod).
# Dashboard: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
